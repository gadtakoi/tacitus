logLevel: info

# Control API for stream monitoring (available only inside Docker network)
api: yes
apiAddress: :9997

# RTSP reception is always enabled; other protocols are disabled by default
rtsp: yes
rtmp: no
hls: no
webrtc: no
srt: no

paths:
{% for path in mediamtx_paths %}
  {{ path.name }}:
    source: {{ path.source | default('publisher') }}
{% endfor %}
