# Managed by Ansible (roles/app_deploy) — do not edit on the server.
#
# Naming matters here. docker-compose.yml reads two different kinds of names:
#   * TACITUS_* — passed straight through to the app container.
#   * S3_*, POSTGRES_*, NGINX_* — interpolated by compose itself and shared
#     between the app, minio and the archive-cleanup container.
# Writing TACITUS_S3_ACCESS_KEY here would be silently ignored: compose sets
# TACITUS_S3_ACCESS_KEY=${S3_ACCESS_KEY:-minioadmin} in its `environment:`
# block, which takes precedence over this file.

# Application settings
TACITUS_APP_NAME={{ tacitus_app_name }}
TACITUS_DEBUG={{ tacitus_debug }}
TACITUS_ENVIRONMENT={{ tacitus_environment }}
TACITUS_CORS_ORIGINS={{ tacitus_cors_origins }}
TACITUS_TRUSTED_PROXY_HOPS={{ tacitus_trusted_proxy_hops }}

# Security secrets (must be overridden for production)
TACITUS_JWT_SECRET={{ tacitus_jwt_secret }}

# S3 / MinIO. Consumed by compose for the app, the minio server and the
# mediamtx-cleanup container, so these are the unprefixed names.
S3_ENDPOINT={{ tacitus_s3_endpoint }}
S3_ACCESS_KEY={{ tacitus_s3_access_key }}
S3_SECRET_KEY={{ tacitus_s3_secret_key }}
S3_BUCKET={{ tacitus_s3_bucket }}

# PostgreSQL. The URL is derived from the same credentials the postgres
# container is initialised with.
POSTGRES_USER={{ tacitus_postgres_user }}
POSTGRES_PASSWORD={{ tacitus_postgres_password }}
POSTGRES_DB={{ tacitus_postgres_db }}
TACITUS_DATABASE_URL=postgresql+asyncpg://{{ tacitus_postgres_user }}:{{ tacitus_postgres_password }}@postgres:5432/{{ tacitus_postgres_db }}

# Rate limiting
TACITUS_RATE_LIMIT_STORAGE_URI={{ tacitus_rate_limit_storage_uri }}

# Nginx settings
NGINX_HOST_PORT={{ nginx_host_port }}
NGINX_HTTPS_PORT={{ nginx_https_port }}

# MediaMTX settings
TACITUS_MTX_RTSP_PORT={{ mediamtx_rtsp_port }}
TACITUS_MTX_RTMP_PORT={{ mediamtx_rtmp_port }}
TACITUS_MTX_HLS_PORT={{ mediamtx_hls_port }}
TACITUS_MTX_WEBRTC_PORT={{ mediamtx_webrtc_port }}
TACITUS_MTX_SRT_PORT={{ mediamtx_srt_port }}
TACITUS_MTX_ICE_PORT={{ mediamtx_ice_port }}
TACITUS_MTX_RTSP_TRANSPORTS={{ mediamtx_rtsp_transports }}
TACITUS_MTX_WEBRTC_ADDITIONAL_HOSTS={{ mediamtx_webrtc_additional_hosts }}
TACITUS_MTX_API_URL={{ mediamtx_api_url }}
# Without these the app falls back to the dev placeholder and its production
# startup check refuses to boot.
TACITUS_MTX_API_USER={{ mediamtx_api_user }}
TACITUS_MTX_API_PASSWORD={{ mediamtx_api_password }}

# MediaMTX archive limits
TACITUS_MTX_MAX_AGE_DAYS={{ mediamtx_max_age_days }}
TACITUS_MTX_MAX_SIZE_GB={{ mediamtx_max_size_gb }}
