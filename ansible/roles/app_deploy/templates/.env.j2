# Application settings
TACITUS_APP_NAME={{ tacitus_app_name }}
TACITUS_DEBUG={{ tacitus_debug }}

# Security secrets (must be overridden for production)
TACITUS_JWT_SECRET={{ tacitus_jwt_secret }}
TACITUS_S3_ACCESS_KEY={{ tacitus_s3_access_key }}
TACITUS_S3_SECRET_KEY={{ tacitus_s3_secret_key }}

# Nginx settings
NGINX_HOST_PORT={{ nginx_host_port }}
