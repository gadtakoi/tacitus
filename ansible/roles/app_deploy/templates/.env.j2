# Application settings
TACITUS_APP_NAME={{ tacitus_app_name }}
TACITUS_DEBUG={{ tacitus_debug }}

# Security secrets (must be overridden for production)
TACITUS_JWT_SECRET={{ tacitus_jwt_secret }}
TACITUS_S3_ACCESS_KEY={{ tacitus_s3_access_key }}
TACITUS_S3_SECRET_KEY={{ tacitus_s3_secret_key }}

# Nginx settings
NGINX_HOST_PORT={{ nginx_host_port }}

# MediaMTX settings
TACITUS_MTX_RTSP_PORT={{ mediamtx_rtsp_port }}
TACITUS_MTX_RTMP_PORT={{ mediamtx_rtmp_port }}
TACITUS_MTX_HLS_PORT={{ mediamtx_hls_port }}
TACITUS_MTX_WEBRTC_PORT={{ mediamtx_webrtc_port }}
TACITUS_MTX_SRT_PORT={{ mediamtx_srt_port }}
TACITUS_MTX_ICE_PORT={{ mediamtx_ice_port }}
TACITUS_MTX_RTSP_TRANSPORTS={{ mediamtx_rtsp_transports }}
TACITUS_MTX_WEBRTC_ADDITIONAL_HOSTS={{ mediamtx_webrtc_additional_hosts }}
TACITUS_MTX_API_URL={{ mediamtx_api_url }}

# MediaMTX archive limits
TACITUS_MTX_MAX_AGE_DAYS={{ mediamtx_max_age_days }}
TACITUS_MTX_MAX_SIZE_GB={{ mediamtx_max_size_gb }}
