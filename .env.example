# Application settings
TACITUS_APP_NAME=tacitus
TACITUS_DEBUG=false
TACITUS_ENVIRONMENT=development
TACITUS_CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app. Decides which X-Forwarded-For
# entry is trusted as the client IP. 1 = behind the bundled nginx; set to 0 when
# the app is exposed directly, otherwise clients can forge their own IP.
TACITUS_TRUSTED_PROXY_HOPS=1

# Database settings
# Full asyncpg URL used by the application and by Alembic migrations.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
TACITUS_DATABASE_URL=postgresql+asyncpg://tacitus:tacitus@postgres:5432/tacitus

# Postgres service credentials (used by docker-compose.yml to create the DB).
POSTGRES_USER=tacitus
POSTGRES_PASSWORD=tacitus
POSTGRES_DB=tacitus
POSTGRES_HOST_PORT=15432

# Интерфейс, на котором публикуется порт PostgreSQL. По умолчанию loopback:
# порт нужен только тестам с хоста. Меняйте вместе с правилом firewall.
TACITUS_POSTGRES_BIND=127.0.0.1
# Порт также публикуется на [::1] (задано в docker-compose.yml): на Windows
# `localhost` резолвится сначала в IPv6, и без этого каждое подключение
# ждёт ~2 с таймаута перед откатом на IPv4.

# Rate limiting storage backend.
# - "memory://" is the default and works for a single local process. Counters
#   are lost on restart and are not shared across instances.
# - "redis://redis:6379" is recommended for production and multi-instance
#   deployments. It provides persistence and a shared counter across all
#   application instances.
TACITUS_RATE_LIMIT_STORAGE_URI=memory://

# JWT settings (override in production with strong secret)
TACITUS_JWT_SECRET=change-me-in-production
TACITUS_JWT_EXPIRATION_MINUTES=15
TACITUS_JWT_REFRESH_EXPIRATION_DAYS=7

# Logging settings
TACITUS_LOG_LEVEL=INFO
TACITUS_LOG_FORMAT=json
TACITUS_LOG_DESTINATION=both
TACITUS_LOG_FILE_PATH=/var/log/tacitus/app.log
TACITUS_LOG_MAX_BYTES=10485760
TACITUS_LOG_BACKUP_COUNT=5

# Sentry settings (leave DSN empty to disable)
TACITUS_SENTRY_DSN=
TACITUS_SENTRY_ENVIRONMENT=development
TACITUS_SENTRY_TRACES_SAMPLE_RATE=0.1

# Nginx settings
NGINX_HOST_PORT=80

# S3 / MinIO settings (dev defaults — use strong credentials in production)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tacitus-files
# Lifetime of presigned download URLs in seconds (60–86400).
TACITUS_PRESIGNED_URL_EXPIRATION=300
# Key prefix of archived recordings inside the bucket. The archive and user
# files share one bucket, so this prefix is the boundary between them:
# /recordings never touches anything outside it, /files never lists anything
# inside it. Must match S3_PREFIX of the mediamtx-cleanup service in
# docker-compose.yml. A trailing slash is added automatically if omitted.
TACITUS_S3_ARCHIVE_PREFIX=mediamtx-archives/

# Anonymous registration through POST /auth/register. There are no roles: any
# account that gets created reaches every file, recording and stream
# configuration. Set to false in production and create accounts with
# scripts/init.sh (which keeps working with registration closed).
TACITUS_REGISTRATION_ENABLED=true

# MediaMTX settings (RTSP streaming server)
TACITUS_MTX_RTSP_PORT=8554
TACITUS_MTX_RTMP_PORT=1935
TACITUS_MTX_HLS_PORT=8888
TACITUS_MTX_WEBRTC_PORT=8889
TACITUS_MTX_SRT_PORT=8890
TACITUS_MTX_ICE_PORT=8189
TACITUS_MTX_RTSP_TRANSPORTS=tcp
TACITUS_MTX_WEBRTC_ADDITIONAL_HOSTS=
TACITUS_MTX_API_URL=http://mediamtx:9997/v3

# Interface the RTSP port is published on. Loopback by default: RTSP Basic
# credentials travel in the clear, so expose the port only to hosts you have
# deliberately allowed (set 0.0.0.0 and add a firewall rule for cameras).
TACITUS_MTX_RTSP_BIND=127.0.0.1

# Credentials the backend uses for the MediaMTX Control API. Must match the
# `tacitus-api` entry of authInternalUsers in mediamtx/mediamtx.yml. The
# application refuses to start in production while the default is in place.
TACITUS_MTX_API_USER=tacitus-api
TACITUS_MTX_API_PASSWORD=dev-api-change-me

# MediaMTX archive limits
TACITUS_MTX_MAX_AGE_DAYS=7
TACITUS_MTX_MAX_SIZE_GB=50

# Recording optimizer (прореживание статичных кадров).
#
# Сервис recording-optimizer декодирует закрытые сегменты записи, выбрасывает
# кадры, не отличающиеся от предыдущего (фильтр ffmpeg mpdecimate), и кладёт
# результат на место оригинала — до того, как его заберёт архиватор. На
# неподвижной сцене это выбрасывает почти все кадры и почти весь объём; на
# сцене с постоянным движением — ничего, и файл остаётся исходным.
#
# Выключен по умолчанию: перекодировка необратима и стоит CPU. Включать
# осознанно, предварительно замерив выигрыш на своей камере.
TACITUS_OPT_ENABLED=false
# Пауза между обходами каталога записей.
TACITUS_OPT_INTERVAL_SECONDS=600
# Через сколько секунд без изменений сегмент считается закрытым. MediaMTX
# дописывает открытый файл каждую секунду (recordPartDuration: 1s), поэтому
# трогать его нельзя. Это же значение читает mediamtx-cleanup: оба сервиса
# обязаны одинаково понимать, какой файл уже никто не пишет.
TACITUS_OPT_MIN_IDLE_SECONDS=300
# Качество перекодировки оставшихся кадров. 18 — классический порог x264
# «глазом неотличимо от оригинала». Меньше — крупнее файл, больше — заметнее
# потери.
TACITUS_OPT_CRF=18
TACITUS_OPT_PRESET=slow
# Пороги mpdecimate: hi/lo — насколько блок кадра должен отличаться, чтобы
# считаться изменившимся, frac — какая доля блоков должна измениться, чтобы
# кадр был сохранён. Дефолты ffmpeg переживают слабый шум матрицы; на шумной
# камере, где экономии нет, поднимать hi и lo.
TACITUS_OPT_HI=768
TACITUS_OPT_LO=320
TACITUS_OPT_FRAC=0.33
# Предохранитель. На шумном источнике перекодировка честно сохраняет шум, и
# файл становится БОЛЬШЕ исходного (замер: 11 МБ → 19 МБ). Если экономия
# меньше этой доли, результат выбрасывается, а оригинал остаётся нетронутым.
TACITUS_OPT_MIN_GAIN_PERCENT=10
# nice для ffmpeg внутри контейнера.
TACITUS_OPT_NICE=10

# Video crop worker (обрезка кадра записанных сегментов).
#
# Сервис video-processor срезает у закрытых сегментов заданную долю кадра
# сверху и снизу и кладёт результат на место оригинала. Перекодирования нет:
# переписывается conformance window в SPS, кадры копируются как есть.
#
# Насколько резать — настройка КАЖДОГО ПОТОКА, а не сервиса: она хранится в
# таблице streams (crop_enabled, crop_top_percent, crop_bottom_percent) и
# правится через /stream-configs или веб-интерфейс. По умолчанию обрезка
# выключена у всех потоков, поэтому сам по себе подъём сервиса ничего не
# трогает. Здесь только параметры самого обхода.
#
# Внимание: срезанные пиксели остаются в файле — обрезка убирает лишние зоны
# кадра, но не является средством сокрытия приватных зон.
#
# Пауза между обходами каталога записей.
TACITUS_CROP_INTERVAL_SECONDS=300
# nice для ffmpeg внутри контейнера.
TACITUS_CROP_NICE=10
# Предел на один ремукс. Часовой сегмент обрабатывается секунды; таймаут нужен
# на случай, когда ffmpeg упёрся в битый файл и не завершается.
TACITUS_CROP_FFMPEG_TIMEOUT_SECONDS=3600
# Порог «сегмент закрыт» общий с recording-optimizer и архиватором и задаётся
# переменной TACITUS_OPT_MIN_IDLE_SECONDS выше.

# Stream simulator (a fake camera that publishes a synthetic RTSP stream).
#
# The service sits behind the compose profile `simulator`: a plain
# `docker compose up` never starts it, and neither does the Ansible deploy,
# which calls compose without --profile. Start it with
# scripts/simulate-stream.sh. Never enable the profile on a server.
TACITUS_SIM_MODE=continuous
TACITUS_SIM_PATHS=cam1
TACITUS_SIM_MTX_HOST=mediamtx
TACITUS_SIM_SIZE=1280x720
TACITUS_SIM_FPS=25
TACITUS_SIM_BITRATE=1500k
# GOP length in seconds. Not cosmetic: MediaMTX starts a recording segment on a
# keyframe, so with ffmpeg's default GOP (250 frames, ~10 s) the first file
# appears long after publishing starts, and the E2E check looks flaky when it
# is not.
TACITUS_SIM_GOP_SECONDS=1
TACITUS_SIM_AUDIO=true
# Reconnect mode: how long each publishing phase lasts and how long the
# publisher stays away. 0 cycles means run forever.
TACITUS_SIM_UP_SECONDS=30
TACITUS_SIM_DOWN_SECONDS=10
TACITUS_SIM_CYCLES=0
# Publisher credentials from authInternalUsers in mediamtx/mediamtx.yml. The
# compose file deliberately has no fallback for the password: an empty value
# stops the simulator instead of letting it fail as a network error, and it
# means the simulator cannot publish on a host whose .env does not define it.
TACITUS_SIM_PUBLISH_USER=publisher
TACITUS_SIM_PUBLISH_PASSWORD=dev-publisher-change-me
# Reader credentials, used only by the negative check: `reader` holds no
# publish action, so MediaMTX must answer 401.
TACITUS_SIM_READ_USER=reader
TACITUS_SIM_READ_PASSWORD=dev-reader-change-me
# A path that is not declared in mediamtx.yml: MediaMTX must answer 400.
TACITUS_SIM_NEGATIVE_PATH=no-such-stream
